# Single source of truth for everything docker-compose.yaml interpolates.
# `docker compose` reads this file automatically; the Makefile also includes it
# so `make up` can print the right URL.

# --- Image ------------------------------------------------------------------
# AIRFLOW_VERSION is the base-image tag the Dockerfile builds FROM. Bump the
# IMAGE_TAG revision suffix (.1, .2, ...) each time the Dockerfile picks up a
# new CVE fix, so a rebuild is distinguishable from what is already running.
AIRFLOW_VERSION=3.3.1
IMAGE_TAG=3.3.1-hardened.1

# UID the containers run as. 50000 is the `airflow` user in the official image;
# it only matters for bind-mounted paths, and ../dags is mounted read-only.
AIRFLOW_UID=50000

# --- Local-dev secrets ------------------------------------------------------
# There is no Vault in this stack (that was a Kubernetes concern), so these
# live here as literals. Same spirit as the kind stack's vault/seed-secrets.sh:
# moving them WHERE they live never made them not-throwaway. Replace both
# before this is reachable by anyone but you.
#
# The Fernet key encrypts Connection passwords and sensitive Variables in the
# metadata DB. It must be 32 bytes, url-safe-base64-encoded. This one decodes
# to the readable "airflow-local-dev-fernet-key-32b" -- the same value the kind
# stack seeds -- so it is obviously a local-dev value. Generate a real one with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# ROTATING THE FERNET KEY IS NOT LIKE THE OTHERS: changing it makes every
# already-encrypted Connection/Variable undecryptable (InvalidToken). Rotate via
# AIRFLOW__CORE__FERNET_KEY="new,old" and re-encrypt, not by editing this.
AIRFLOW_FERNET_KEY=YWlyZmxvdy1sb2NhbC1kZXYtZmVybmV0LWtleS0zMmI=

# Signs API-server sessions and the JWTs the Celery workers present to the task
# execution API. Fixed rather than generated so sessions survive a restart and
# every service agrees on the same secret.
AIRFLOW_API_SECRET_KEY=airflow-local-dev-api-secret-key

# --- Demo users -------------------------------------------------------------
# Created by bootstrap/init.sh. Username == password, matching the four
# Keycloak users the kind stack ships.
ADMIN_PASSWORD=admin
ALICE_PASSWORD=alice
BOB_PASSWORD=bob
CAROL_PASSWORD=carol

# --- Networking -------------------------------------------------------------
AIRFLOW_PORT=8080

# --- Worker classes ---------------------------------------------------------
# One worker container per class, mirroring airflow.workers.celery.sets in the
# kind stack's chart/values.yaml. Those were Kubernetes requests+limits; here
# they are hard container caps, so they are sized at roughly the chart's limit
# rather than its request. Keep them small enough that all three fit on your
# machine at once.
WORKER_SMALL_CPUS=0.5
WORKER_SMALL_MEM=512m
WORKER_MEDIUM_CPUS=1.0
WORKER_MEDIUM_MEM=1g
WORKER_LARGE_CPUS=2.0
WORKER_LARGE_MEM=2g
